# Airflow deployment configuration
AIRFLOW_UID=50000
# Generate a fernet key: python -c "import base64, secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
FERNET_KEY=your_generated_fernet_key_here

# AWS Authentication & Region (provide IAM credentials with access to S3, Lambda, Glue)
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=ap-south-1
AWS_REGION=ap-south-1
